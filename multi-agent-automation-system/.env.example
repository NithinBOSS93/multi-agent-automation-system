# Copy this file to .env (in the project root or in backend/) and fill in your keys.

# Required — free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Optional — better web search, free key from https://tavily.com
TAVILY_API_KEY=

# Change this to any long random string
JWT_SECRET=change-me-to-a-long-random-string
